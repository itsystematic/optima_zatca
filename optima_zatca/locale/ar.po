"&lt;p&gt;عزيزي {{ doc.contact_person }}،&lt;/p&gt;\n"
"\n"
"&lt;p&gt;نرجو سداد {{ doc.doctype }} {{ doc.name }} بمبلغ {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; انقروا هنا للسداد &lt;/a&gt;\n"
"\n"
"</pre>"

