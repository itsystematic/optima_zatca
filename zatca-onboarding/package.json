{
  "name": "zatca-onboarding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ZATCA_API=mock vite",
    "build": "vite build --base=/assets/optima_zatca/zatca-onboarding/ && yarn copy-html-entry",
    "copy-html-entry": "cp ../optima_zatca/public/zatca-onboarding/index.html ../optima_zatca/www/zatca-onboarding.html",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/ibm-plex-sans": "^5",
    "frappe-ui": "1.1.0",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT"
}
