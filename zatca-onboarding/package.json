{
	"name": "optima-zatca-onboarding",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && cp src/assets/it-logo.webp ../optima_zatca/public/images/it-logo.webp && cp ../optima_zatca/public/zatca-onboarding/index.html ../optima_zatca/www/zatca-onboarding.html",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"test": "VITE_OZ_API=mock vitest run",
		"test:watch": "VITE_OZ_API=mock vitest",
		"e2e": "VITE_OZ_API=mock playwright test",
		"e2e:ui": "VITE_OZ_API=mock playwright test --ui",
		"dev:mock": "VITE_OZ_API=mock vite",
		"publish-page": "cp src/assets/it-logo.webp ../optima_zatca/public/images/it-logo.webp && cp ../optima_zatca/public/zatca-onboarding/index.html ../optima_zatca/www/zatca-onboarding.html",
		"e2e:live": "playwright test --config playwright.live.config.ts"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.4",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.9.1",
		"socket.io-client": "^4.8.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.2",
		"jsdom": "^30.0.1",
		"typescript": "~5.9.2",
		"vite": "^7.1.5",
		"vitest": "^3.2.7"
	}
}
