{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"baseUrl": ".",
		"paths": {
			// mirrors the build-time aliases in vite.config.ts; TypeScript always
			// checks against the production side, which is the stricter one
			"@/dev-toolbar": ["src/components/DevToolbar.off.tsx"],
			"@/*": ["src/*"]
		}
	},
	"include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "proxyOptions.ts"]
}
