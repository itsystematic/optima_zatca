{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"#backend": ["./src/api/live.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
